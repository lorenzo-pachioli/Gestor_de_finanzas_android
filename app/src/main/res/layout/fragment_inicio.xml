<?xml version="1.0" encoding="utf-8"?>
<!-- ARCHIVO COMPLETO: app/src/main/res/layout/fragment_inicio.xml -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Tarjeta 1: Balance y Detalles -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_16dp"
        android:layout_marginTop="@dimen/space_12dp"
        android:layout_marginBottom="@dimen/space_4dp"
        android:elevation="@dimen/elevation_4dp"
        app:cardCornerRadius="@dimen/radius_12dp"
        app:cardBackgroundColor="@color/background_card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_12dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_4dp">
                
                <TextView
                    android:id="@+id/tvMonthTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="@string/resumen_de"
                    android:textSize="@dimen/text_12sp"
                    android:textColor="@color/text_secondary"/>

                <TextView
                    android:id="@+id/tvViewDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="@string/view_detail"
                    android:textSize="@dimen/text_12sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_main"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"/>
            </RelativeLayout>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvBalance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/balance_zero"
                android:textSize="@dimen/text_28sp"
                android:textStyle="bold"
                android:textColor="@color/green"
                android:maxLines="1"
                android:ellipsize="end"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="@dimen/text_16sp"
                app:autoSizeMaxTextSize="@dimen/text_28sp"
                app:autoSizeStepGranularity="@dimen/text_2sp"
                android:layout_marginBottom="@dimen/space_8dp"/>

            <!-- Fila Ingresos -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_2dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="@string/transactions_income"
                    android:textSize="@dimen/text_12sp"
                    android:textColor="@color/text_secondary"/>
                <TextView
                    android:id="@+id/tvIngresos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="@string/balance_zero"
                    android:textSize="@dimen/text_12sp"
                    android:textStyle="bold"
                    android:textColor="@color/green"/>
            </RelativeLayout>

            <!-- Fila Egresos -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="@string/transactions_expense"
                    android:textSize="@dimen/text_12sp"
                    android:textColor="@color/text_secondary"/>
                <TextView
                    android:id="@+id/tvEgresos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="@string/balance_zero"
                    android:textSize="@dimen/text_12sp"
                    android:textStyle="bold"
                    android:textColor="@color/red"/>
            </RelativeLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Tarjeta 2: Total Disponible -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTotalAvailable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/cardSummary"
        android:layout_marginHorizontal="@dimen/space_16dp"
        android:layout_marginBottom="@dimen/space_8dp"
        android:elevation="@dimen/elevation_2dp"
        app:cardCornerRadius="@dimen/radius_12dp"
        app:cardBackgroundColor="@color/background_card">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/space_12dp">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="@string/total_available_label"
                android:textSize="@dimen/text_16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"/>
                
            <TextView
                android:id="@+id/tvTotalAvailable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="@string/available_zero"
                android:textSize="@dimen/text_16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"/>
        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/emptyView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="@string/no_notificaciones"
        android:textSize="@dimen/text_20sp"
        android:textColor="#666666"
        android:visibility="visible"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/cardTotalAvailable"
        android:layout_marginHorizontal="@dimen/space_8dp"
        android:paddingBottom="@dimen/space_72dp"
        android:clipToPadding="false"
        android:visibility="gone"/>

</RelativeLayout>

