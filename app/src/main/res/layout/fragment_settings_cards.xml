<?xml version="1.0" encoding="utf-8"?>
<!-- ARCHIVO: app/src/main/res/layout/fragment_settings_cards.xml -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingBottom="80dp"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="‹"
                android:textSize="28sp"
                android:textColor="@color/accent_main"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tarjetas_credito"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"/>
        </LinearLayout>

        <!-- Sección Agregar -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Agregar Nueva"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/accent_main"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnAddCreditCard"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_rounded"
            android:text="@string/agregar"
            android:textColor="@color/text_primary" 
            android:layout_marginBottom="24dp"/>

        <!-- Sección Editar -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Editar o Eliminar Existente"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/accent_main"
            android:layout_marginBottom="8dp"/>

        <Spinner
            android:id="@+id/spinnerCreditCards"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:padding="5dp"
            android:background="@drawable/bg_spinner_field"
            android:textColor="@color/text_secondary"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
