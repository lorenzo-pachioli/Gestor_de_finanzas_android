<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".fragments.HistorialFragment">

    <Button
        android:id="@+id/btnEnableAccess"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_card_rounded"
        android:backgroundTint="@null"
        android:backgroundTintMode="@null"
        android:padding="10dp"
        android:text="@string/habilitar_acceso_notificaciones"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:visibility="visible" />

    <!-- Header Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvHistorialTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/historial_pendiente"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnClearAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/borrar_todo"
            android:backgroundTint="@color/red"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp" />
    </LinearLayout>

    <!-- Description -->
    <TextView
        android:id="@+id/tvHistorialDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="12dp"
        android:text="@string/historial_descripcion"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewHistorial"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="8dp"
        android:paddingBottom="75dp"
        android:clipToPadding="false"
        android:visibility="visible" />

    <TextView
        android:id="@+id/emptyViewHistorial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:text="@string/no_notificaciones"
        android:textAlignment="center"
        android:textColor="@color/text_secondary"
        android:textSize="18sp"
        android:visibility="gone"
        tools:ignore="RtlCompat" />

</LinearLayout>