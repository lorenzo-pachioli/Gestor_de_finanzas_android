<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".fragments.HistorialFragment">

    <!-- Estado: Sin permiso -->
    <ScrollView
        android:id="@+id/layoutPermissionNeeded"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_24dp"
            android:gravity="center_horizontal">

            <ImageView
                android:layout_width="@dimen/size_80dp"
                android:layout_height="@dimen/size_80dp"
                android:layout_marginTop="@dimen/space_40dp"
                android:layout_marginBottom="@dimen/space_24dp"
                android:src="@android:drawable/ic_dialog_info"
                app:tint="@color/accent_main" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/permiso_notificaciones_titulo"
                android:textSize="@dimen/text_20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="@dimen/space_16dp"
                android:textAlignment="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/permiso_notificaciones_descripcion"
                android:textSize="@dimen/text_16sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="@dimen/space_32dp"
                android:lineSpacingExtra="@dimen/size_4dp"
                android:textAlignment="center" />

            <Button
                android:id="@+id/btnEnableAccess"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_rounded"
                android:text="@string/habilitar_acceso_notificaciones"
                android:textColor="@color/white"
                android:textSize="@dimen/text_16sp"
                android:textAllCaps="false"
                android:padding="@dimen/space_12dp"
                android:backgroundTint="@color/accent_main" />

        </LinearLayout>
    </ScrollView>

    <!-- Estado: Con permiso (Contenido normal) -->
    <LinearLayout
        android:id="@+id/layoutHistoryContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- Header Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_16dp"
            android:paddingEnd="@dimen/space_16dp"
            android:paddingTop="@dimen/space_8dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvHistorialTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/historial_pendiente"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnClearAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/borrar_todo"
                android:backgroundTint="@color/red"
                android:textColor="@color/white"
                android:textSize="@dimen/text_12sp"
                android:paddingHorizontal="@dimen/space_16dp"
                android:paddingVertical="@dimen/space_8dp" />
        </LinearLayout>

        <!-- Description -->
        <TextView
            android:id="@+id/tvHistorialDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/space_16dp"
            android:paddingEnd="@dimen/space_16dp"
            android:paddingTop="@dimen/space_4dp"
            android:paddingBottom="@dimen/space_12dp"
            android:text="@string/historial_descripcion"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_16sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewHistorial"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="@dimen/space_8dp"
            android:paddingBottom="@dimen/space_72dp"
            android:clipToPadding="false"
            android:visibility="visible" />

        <TextView
            android:id="@+id/emptyViewHistorial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="@string/no_notificaciones"
            android:textAlignment="center"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_20sp"
            android:visibility="gone"
            tools:ignore="RtlCompat" />
    </LinearLayout>

</LinearLayout>
