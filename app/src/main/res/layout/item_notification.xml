<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/space_8dp"
    app:cardBackgroundColor="@color/background_card"
    app:cardCornerRadius="@dimen/radius_8dp"
    app:cardElevation="@dimen/elevation_4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Left Border -->
        <View
            android:id="@+id/viewNotificationBorder"
            android:layout_height="match_parent"
            android:layout_width="@dimen/size_12dp"
            android:background="@color/text_secondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <!-- Vista Resumen -->
        <LinearLayout
            android:id="@+id/layoutSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/tvAppName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name_placeholder"
                        android:textStyle="bold"
                        android:textSize="@dimen/text_12sp"
                        android:textColor="@color/accent_main"
                        android:layout_marginBottom="@dimen/space_4dp"
                        android:layout_marginRight="@dimen/space_20dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/slash"
                        android:textStyle="bold"
                        android:textSize="@dimen/text_12sp"
                        android:textColor="@color/accent_main"
                        android:layout_marginBottom="@dimen/space_4dp"
                        android:layout_marginRight="@dimen/space_20dp"/>

                    <TextView
                        android:id="@+id/tvCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/categoria_placeholder"
                        android:textStyle="bold"
                        android:textSize="@dimen/text_12sp"
                        android:textColor="@color/accent_main"
                        android:layout_marginBottom="@dimen/space_4dp"/>
                </LinearLayout>


                <TextView
                    android:id="@+id/tvNotificacion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/notificacion"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_12sp"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_button_rounded_2"
                    android:paddingHorizontal="@dimen/space_12dp"
                    android:paddingVertical="@dimen/space_2dp"
                    android:layout_marginLeft="@dimen/space_60dp"
                    android:layout_marginBottom="@dimen/space_2dp"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_4dp"
                        android:text="@string/notification_title_placeholder"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_4dp"
                        android:text="@string/notification_text_placeholder"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_16sp" />

                    <TextView
                        android:id="@+id/tvAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4dp"
                        android:layout_marginBottom="@dimen/space_8dp"
                        android:text="@string/amount_placeholder"
                        android:textColor="@color/green"
                        android:textSize="@dimen/text_20sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvTimestamp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/date_placeholder"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_12sp" />
                </LinearLayout>


                <ImageButton
                    android:id="@+id/btnAdd"
                    android:layout_width="@dimen/size_48dp"
                    android:layout_height="@dimen/size_48dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="@dimen/space_8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_input_add"
                    app:tint="@color/accent_main"
                    android:contentDescription="@string/agregar_transaccion"/>

                <ImageButton
                    android:id="@+id/btnDelete"
                    android:layout_width="@dimen/size_48dp"
                    android:layout_height="@dimen/size_48dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="@dimen/space_8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_delete"
                    app:tint="@color/red"
                    android:contentDescription="Eliminar notificaciÃ³n"/>

            </LinearLayout>



        </LinearLayout>

        <!-- Vista EdiciÃ³n -->
        <LinearLayout
            android:id="@+id/layoutEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_16dp"
            android:visibility="gone"
            android:background="@color/background_card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/editar_notificacion"
                android:textStyle="bold"
                android:textSize="@dimen/text_16sp"
                android:textColor="@color/accent_main"
                android:layout_marginBottom="@dimen/space_8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/titulo"
                android:textSize="@dimen/text_12sp"/>
            <EditText
                android:id="@+id/etTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_rounded"
                android:padding="@dimen/space_12dp"
                android:layout_marginBottom="@dimen/space_8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/contenido"
                android:textSize="@dimen/text_12sp"/>
            <EditText
                android:id="@+id/etText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_rounded"
                android:padding="@dimen/space_12dp"
                android:hint="@string/notification_text_placeholder"
                android:layout_marginBottom="@dimen/space_8dp"/>

            <com.notificationcapture.app.utils.CustomTypeSwitch
                android:id="@+id/switchType"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_40dp"
                android:layout_marginBottom="@dimen/space_8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/monto"
                android:textSize="@dimen/text_12sp"/>
            <EditText
                android:id="@+id/etAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="phone"
                android:digits="0123456789.,"
                android:background="@drawable/bg_card_rounded"
                android:padding="@dimen/space_12dp"
                android:layout_marginBottom="@dimen/space_8dp"/>
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/categoria"
                android:textSize="@dimen/text_12sp"/>
            <TextView
                android:id="@+id/tvCategorySelector"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_48dp"
                android:background="@drawable/bg_card_rounded"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/space_12dp"
                android:paddingEnd="@dimen/space_12dp"
                android:textColor="@color/text_secondary"
                android:text="@string/categoria_placeholder"
                android:drawableEnd="@android:drawable/arrow_down_float"
                android:layout_marginBottom="@dimen/space_8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/aplicacion_origen"
                android:textSize="@dimen/text_12sp"/>
            <TextView
                android:id="@+id/tvPaymentMethod"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_48dp"
                android:background="@drawable/bg_card_rounded"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/space_12dp"
                android:paddingEnd="@dimen/space_12dp"
                android:textColor="@color/text_secondary"
                android:text="@string/metodo_pago"
                android:drawableEnd="@android:drawable/arrow_down_float"
                android:layout_marginBottom="@dimen/space_16dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/space_16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/es_notificacion"
                    android:textSize="@dimen/text_16sp"
                    android:textColor="@color/text_primary"/>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchIsNotification"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end">

                <Button
                    android:id="@+id/btnCancel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cancelar"
                    android:backgroundTint="#CCCCCC"
                    android:textColor="@color/black"
                    android:layout_marginEnd="@dimen/space_8dp"/>

                <Button
                    android:id="@+id/btnSave"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/guardar"
                    android:backgroundTint="@color/accent_main"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>

        </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
