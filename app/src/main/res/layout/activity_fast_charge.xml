<?xml version="1.0" encoding="utf-8"?>
<!-- ARCHIVO COMPLETO: app/src/main/res/layout/activity_fast_charge.xml -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/space_24dp"
        app:cardCornerRadius="@dimen/radius_16dp"
        app:cardBackgroundColor="@color/primary_main"
        android:alpha="0.95"
        app:cardElevation="@dimen/elevation_8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/carga_rapida"
                android:textSize="@dimen/text_20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="@dimen/space_16dp" />

            <!-- Monto -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8dp"
                android:layout_marginBottom="@dimen/space_16dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_4dp"
                    android:text="@string/symbol_currency"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_36sp"
                    android:textStyle="normal" />

                <EditText
                    android:id="@+id/etFastChargeAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:digits="0123456789.,"
                    android:hint="@string/hint_zero"
                    android:imeOptions="actionDone"
                    android:inputType="numberDecimal"
                    android:minHeight="@dimen/size_48dp"
                    android:padding="@dimen/space_4dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="@dimen/text_44sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Título -->
            <EditText
                android:id="@+id/etFastChargeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_titulo"
                android:textColorHint="@color/text_secondary"
                android:minHeight="@dimen/size_48dp"
                android:padding="@dimen/space_12dp"
                android:background="@drawable/bg_card_rounded"
                android:textColor="@color/text_secondary"
                android:inputType="textCapSentences"
                android:maxLines="1"
                android:layout_marginBottom="@dimen/space_20dp"/>

            <!-- Tipo Ingreso/Egreso -->
            <com.notificationcapture.app.utils.CustomTypeSwitch
                android:id="@+id/swFastChargeType"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_56dp"
                android:layout_marginBottom="@dimen/space_20dp" />

            <!-- Método de Pago -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/togglePaymentMethod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:checkedButton="@+id/btnMethodCash"
                android:layout_marginBottom="@dimen/space_16dp">

                <Button
                    android:id="@+id/btnMethodCash"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/efectivo"
                    android:textSize="@dimen/text_12sp" />

                <Button
                    android:id="@+id/btnMethodDebit"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/debito"
                    android:textSize="@dimen/text_12sp" />

                <Button
                    android:id="@+id/btnMethodCredit"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/credito"
                    android:textSize="@dimen/text_12sp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Selector de Billetera (solo visible con Débito) -->
            <LinearLayout
                android:id="@+id/layoutWalletSelector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="@dimen/space_16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/wallet_label"
                    android:textSize="@dimen/text_16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="@dimen/space_8dp"/>

                <Spinner
                    android:id="@+id/spinnerWalletsFastCharge"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_60dp"
                    android:background="@drawable/bg_spinner_field"
                    android:padding="@dimen/space_8dp" />
            </LinearLayout>

            <!-- Cuotas (solo visible con Crédito) -->
            <LinearLayout
                android:id="@+id/layoutInstallments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="@dimen/space_16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cuotas"
                    android:textSize="@dimen/text_16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="@dimen/space_8dp"/>

                <EditText
                    android:id="@+id/etInstallments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/cuotas"
                    android:padding="@dimen/space_12dp"
                    android:background="@drawable/bg_card_rounded"
                    android:textColorHint="@color/text_secondary"
                    android:textColor="@color/text_secondary"
                    android:inputType="number"
                    android:text="@string/payment_method_one" />
            </LinearLayout>

            <!-- Botones -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end"
                android:layout_marginTop="@dimen/space_8dp">

                <Button
                    android:id="@+id/btnCancelFastCharge"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cancelar" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveFastCharge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_8dp"
                    android:text="@string/guardar"
                    android:backgroundTint="@color/accent_main"
                    android:textColor="@color/white"
                    app:strokeColor="@color/accent_main"
                    app:strokeWidth="@dimen/stroke_2dp"
                    app:cornerRadius="@dimen/radius_12dp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvSuccessMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/guardado_exito"
                android:textColor="@color/green"
                android:gravity="center"
                android:visibility="gone"
                android:layout_marginTop="@dimen/space_16dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</ScrollView>



