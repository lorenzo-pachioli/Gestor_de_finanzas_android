<?xml version="1.0" encoding="utf-8"?>
<!-- ARCHIVO COMPLETO: app/src/main/res/layout/fragment_perfil.xml -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- MENÚ PRINCIPAL de configuración -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/layoutSettingsMenu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="@dimen/space_80dp"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:background="@android:color/transparent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/configuracion"
                android:textSize="@dimen/text_24sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="@dimen/space_24dp"/>

            
            <!-- Idioma -->
            <com.notificationcapture.app.utils.CustomLanguageSwitch
                android:id="@+id/swLanguage"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_56dp"
                android:layout_marginBottom="@dimen/space_8dp" />

            <!-- Modo Oscuro -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="@dimen/space_16dp"
                android:background="@drawable/bg_card_rounded"
                android:layout_marginBottom="@dimen/space_8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/modo_oscuro"
                    android:textSize="@dimen/text_16sp"
                    android:textColor="@color/text_primary"/>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/size_40dp">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchDarkMode"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:thumb="@drawable/selector_switch_thumb_day_night"
                        app:thumbTint="@null"
                        app:trackTint="@null"
                        app:track="@drawable/track"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>

            <!-- Ítem: Categorías -->
            <LinearLayout
                android:id="@+id/itemCategorias"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_64dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="@dimen/space_16dp"
                android:background="@drawable/bg_card_rounded"
                android:layout_marginBottom="@dimen/space_8dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/categorias"
                    android:textSize="@dimen/text_16sp"
                    android:textColor="@color/text_primary"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/forward_chevron"
                    android:textSize="@dimen/text_20sp"
                    android:textColor="@color/text_secondary"/>
            </LinearLayout>

            <!-- Ítem: Billeteras -->
            <LinearLayout
                android:id="@+id/itemBilleteras"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_64dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="@dimen/space_16dp"
                android:background="@drawable/bg_card_rounded"
                android:layout_marginBottom="@dimen/space_8dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/billeteras_bancos"
                    android:textSize="@dimen/text_16sp"
                    android:textColor="@color/text_primary"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/forward_chevron"
                    android:textSize="@dimen/text_20sp"
                    android:textColor="@color/text_secondary"/>
            </LinearLayout>

            <!-- Ítem: Tarjetas de Crédito -->
            <LinearLayout
                android:id="@+id/itemTarjetas"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_64dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="@dimen/space_16dp"
                android:background="@drawable/bg_card_rounded"
                android:layout_marginBottom="@dimen/space_8dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tarjetas_credito"
                    android:textSize="@dimen/text_16sp"
                    android:textColor="@color/text_primary"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/forward_chevron"
                    android:textSize="@dimen/text_20sp"
                    android:textColor="@color/text_secondary"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- CONTAINER para sub-pantallas (oculto por defecto) -->
    <FrameLayout
        android:id="@+id/settingsDetailContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="@android:color/transparent"/>

</FrameLayout>


