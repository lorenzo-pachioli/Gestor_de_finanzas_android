<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Términos y Privacidad"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/tvLegalText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.5"
            android:textSize="13sp"/>

    </ScrollView>

    <CheckBox
        android:id="@+id/cbAcceptTerms"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Leí y acepto los Términos y Condiciones y la Política de Privacidad"
        android:layout_marginTop="16dp"/>

    <Button
        android:id="@+id/btnAcceptAndContinue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Aceptar y continuar"
        android:layout_marginTop="12dp"
        android:enabled="false"/>

</LinearLayout>
