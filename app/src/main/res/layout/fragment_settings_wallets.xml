<?xml version="1.0" encoding="utf-8"?>
<!-- ARCHIVO: app/src/main/res/layout/fragment_settings_wallets.xml -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingBottom="@dimen/space_80dp"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_16dp">

        <LinearLayout
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/space_16dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/back_chevron"
                android:textSize="@dimen/text_28sp"
                android:textColor="@color/accent_main"
                android:layout_marginEnd="@dimen/space_8dp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/billeteras_bancos"
                android:textSize="@dimen/text_20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/select_wallets_used"
            android:textSize="@dimen/text_16sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="@dimen/space_16dp"/>

        <!-- Sección Agregar -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/add_new_category"
            android:textSize="@dimen/text_16sp"
            android:textStyle="bold"
            android:textColor="@color/accent_main"
            android:layout_marginBottom="@dimen/space_8dp"/>

        <Button
            android:id="@+id/btnAddWallet"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_rounded"
            android:text="@string/agregar"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="@dimen/space_24dp" />

        <!-- Sección Editar -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/edit_or_delete_existing"
            android:textSize="@dimen/text_16sp"
            android:textStyle="bold"
            android:textColor="@color/accent_main"
            android:layout_marginBottom="@dimen/space_8dp"/>

        <Spinner
            android:id="@+id/spinnerWallets"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_60dp"
            android:padding="@dimen/space_8dp"
            android:background="@drawable/bg_spinner_field"
            android:textColor="@color/text_secondary"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>



