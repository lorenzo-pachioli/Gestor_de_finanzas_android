<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="@dimen/space_4dp"
    android:paddingLeft="@dimen/space_2dp"
    android:paddingRight="@dimen/space_2dp"
    android:paddingTop="@dimen/space_4dp"
    android:layout_margin="@dimen/space_4dp"
    android:orientation="vertical">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_4dp"
        app:cardBackgroundColor="@color/background_main"
        app:cardCornerRadius="@dimen/radius_8dp"
        app:cardElevation="@dimen/elevation_2dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/size_48dp">

            <!-- Background Tint -->
            <View
                android:id="@+id/viewBackgroundTint"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:alpha="0.15"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:background="@color/background_card" />

            <!-- Left Border -->
            <View
                android:id="@+id/viewLeftBorder"
                android:layout_width="@dimen/size_8dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:background="#4CAF50" />

            <TextView
                android:id="@+id/tvCategoryName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_16dp"
                android:layout_marginEnd="@dimen/space_8dp"
                android:layout_marginTop="@dimen/space_12dp"
                android:layout_marginBottom="@dimen/space_12dp"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_16sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/tvCategoryAmount"
                app:layout_constraintStart_toEndOf="@+id/viewLeftBorder"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="@string/category_example"
                tools:ignore="NotSibling" />

            <LinearLayout
                android:id="@+id/amountContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_16dp"
                android:gravity="end"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tvCategoryPercentage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_12sp"
                    android:layout_marginEnd="@dimen/space_8dp"
                    tools:text="@string/percentage_example" />

                <TextView
                    android:id="@+id/tvCategoryAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_16sp"
                    android:textStyle="bold"
                    tools:text="@string/amount_example" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>
</LinearLayout>

