<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_main">

    <!-- Animated container: logo + name animate together as a heartbeat -->
    <LinearLayout
            android:id="@+id/splashContent"
            android:layout_width="312dp"
            android:layout_height="499dp"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingBottom="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

        <ImageView
                android:id="@+id/ic_launcher_icon"
                android:layout_width="287dp"
                android:layout_height="222dp"
                android:src="@mipmap/ic_launcher_foreground"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"/>

        <ImageView
                android:id="@+id/splashLogo"
                android:layout_width="209dp"
                android:layout_height="65dp"
                android:src="@drawable/fluxus_logo"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"/>

        <TextView
                android:id="@+id/splashSlogan"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:text="@string/app_slogan"
                android:fontFamily="@font/sf_pro"
                android:textSize="18sp"
                android:textColor="@color/secondary_main"
                android:letterSpacing="0.02"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
