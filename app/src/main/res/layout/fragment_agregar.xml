<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">
<!--    -->


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_8dp"
            android:text="@string/agregar_movimiento"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_24sp"
            android:textStyle="bold" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16dp"
            android:layout_marginBottom="@dimen/space_16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_4dp"
                android:text="@string/symbol_currency"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_44dp"
                android:textStyle="normal" />

            <EditText
                android:id="@+id/etAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@null"
                android:digits="0123456789.,"
                android:hint="@string/hint_zero"
                android:imeOptions="actionDone"
                android:inputType="phone"
                android:minHeight="@dimen/size_48dp"
                android:padding="@dimen/space_4dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="@dimen/text_56dp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Tipo de Transacción -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tipo_transaccion"
            android:textSize="@dimen/text_16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="@dimen/space_4dp"/>

        <com.notificationcapture.app.utils.CustomTypeSwitch
            android:id="@+id/swType"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_56dp"
            android:layout_marginBottom="@dimen/space_8dp" />

        <!-- Selector de Categoría -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/categoria_label"
            android:textSize="@dimen/text_16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="@dimen/space_8dp"/>

        <Spinner
            android:id="@+id/spinnerCategory"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_64dp"
            android:padding="@dimen/space_2dp"
            android:background="@drawable/bg_spinner_field"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="@dimen/space_8dp"/>

        <!-- Selector de Metodo de Pago -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/payment_method_label"
            android:textSize="@dimen/text_16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="@dimen/space_8dp"/>

        <TextView
            android:id="@+id/tvPaymentMethod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/size_48dp"
            android:padding="@dimen/space_12dp"
            android:background="@drawable/bg_spinner_field"
            android:textColor="@color/text_secondary"
            android:text="@string/cash"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/space_12dp"
            android:clickable="true"
            android:focusable="true"/>

        <!-- Campo Título -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/titulo_transaccion"
            android:textSize="@dimen/text_16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="@dimen/space_8dp"/>

        <EditText
            android:id="@+id/etTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_titulo"
            android:textColorHint="@color/text_secondary"
            android:minHeight="@dimen/size_48dp"
            android:padding="@dimen/space_12dp"
            android:background="@drawable/bg_card_rounded"
            android:textColor="@color/text_secondary"
            android:inputType="text"
            android:maxLines="1"
            android:layout_marginBottom="@dimen/space_12dp"/>

        <!-- Selector de Fecha -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/fecha_movimiento"
            android:textSize="@dimen/text_16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="@dimen/space_8dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_12dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/seleccionar_fecha"
                android:textColorHint="@color/text_secondary"
                android:textColor="@color/text_secondary"
                android:minHeight="@dimen/size_48dp"
                android:padding="@dimen/space_12dp"
                android:focusable="false"
                android:clickable="true"
                android:inputType="none"
                android:drawableEnd="@android:drawable/ic_menu_today"
                android:drawablePadding="@dimen/space_12dp"/>

        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTransferLink"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:text="@string/transfer_link"
                android:textSize="@dimen/text_16sp"
                android:textColor="@color/accent_main"
                android:gravity="center"
                android:padding="@dimen/space_2dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/campos_obligatorios"
                android:textSize="@dimen/text_8sp"
                android:textColor="@color/text_secondary"
                android:textStyle="italic"
                android:gravity="center_vertical|end"
                android:paddingStart="@dimen/space_8dp"/>
        </LinearLayout>

        <!-- Botón Crear -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCreate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/crear_transaccion"
            android:textSize="@dimen/text_16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_rounded"
            android:padding="@dimen/space_8dp"
            android:minHeight="@dimen/size_48dp" />

    </LinearLayout>

</ScrollView>



