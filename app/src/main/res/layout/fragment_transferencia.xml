<?xml version="1.0" encoding="utf-8"?>
<!-- ARCHIVO NUEVO: app/src/main/res/layout/fragment_transferencia.xml -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingBottom="@dimen/space_80dp"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/transfer_between_accounts"
            android:textSize="@dimen/text_20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="@dimen/space_8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/transfer_between_accounts_desc"
            android:textSize="@dimen/text_16sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="@dimen/space_24dp"/>

        <!-- Monto -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_24dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_4dp"
                android:text="@string/symbol_currency"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_36sp"/>

            <EditText
                android:id="@+id/etTransferAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@null"
                android:digits="0123456789.,"
                android:hint="@string/hint_zero"
                android:imeOptions="actionDone"
                android:inputType="phone"
                android:minHeight="@dimen/size_48dp"
                android:padding="@dimen/space_4dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="@dimen/text_44sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Desde -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/from_label"
            android:textSize="@dimen/text_16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="@dimen/space_8dp"/>

        <Spinner
            android:id="@+id/spinnerOrigen"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_60dp"
            android:padding="@dimen/space_8dp"
            android:background="@drawable/bg_spinner_field"
            android:layout_marginBottom="@dimen/space_20dp"/>

        <!-- Hacia -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/to_label"
            android:textSize="@dimen/text_16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="@dimen/space_8dp"/>

        <Spinner
            android:id="@+id/spinnerDestino"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_60dp"
            android:padding="@dimen/space_8dp"
            android:background="@drawable/bg_spinner_field"
            android:layout_marginBottom="@dimen/space_20dp"/>

        <!-- Fecha -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/date_label"
            android:textSize="@dimen/text_16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="@dimen/space_8dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_24dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTransferDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/transfer_date_hint"
                android:textColorHint="@color/text_secondary"
                android:textColor="@color/text_secondary"
                android:minHeight="@dimen/size_48dp"
                android:padding="@dimen/space_12dp"
                android:focusable="false"
                android:clickable="true"
                android:inputType="none"
                android:drawableEnd="@android:drawable/ic_menu_today"
                android:drawablePadding="@dimen/space_12dp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Botón registrar -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnRegistrarTransferencia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/register_transfer"
            android:textSize="@dimen/text_16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_rounded"
            android:padding="@dimen/space_8dp"
            android:minHeight="@dimen/size_48dp"/>

    </LinearLayout>
</ScrollView>



