<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.NotificationCapture" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="android:windowBackground">@color/background_card_90</item>
        <item name="android:colorBackground">@color/background_card_90</item>
        <item name="android:statusBarColor">@color/background_card</item>
        
        <!-- Material3 Color System - Mapped to custom palette -->
        <item name="colorPrimary">@color/accent_secondary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/accent_secondary</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>
        
        <item name="colorSecondary">@color/secondary_main</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/background_card</item>
        <item name="colorOnSecondaryContainer">@color/text_primary</item>
        
        <item name="colorTertiary">@color/accent_secondary</item>
        <item name="colorOnTertiary">@color/white</item>
        
        <item name="colorSurface">@color/background_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/background_main</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        
        <item name="colorError">@color/red</item>
        <item name="colorOnError">@color/white</item>
        
        <item name="android:colorControlNormal">@color/text_secondary</item>
        <item name="android:colorControlActivated">@color/accent_secondary</item>
        <item name="android:colorControlHighlight">@color/accent_secondary</item>
        
        <!-- Legacy compatibility -->
        <item name="colorAccent">@color/accent_secondary</item>

        <!-- Global style for all Material Buttons -->
        <item name="materialButtonStyle">@style/Widget.App.Button</item>

        <item name="android:windowLightStatusBar">true</item>
        <item name="floatingActionButtonStyle">@style/Widget.Material3.FloatingActionButton.Primary</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Material3.Corner.Full</item>
        <item name="android:spinnerStyle">@style/Widget.App.Spinner</item>

        <!-- Global Typography -->
        <item name="android:fontFamily">@font/titillium_web</item>
        <item name="fontFamily">@font/titillium_web</item>

    </style>

    <style name="Theme.NotificationCapture" parent="Base.Theme.NotificationCapture" />

    <style name="FullScreenBottomSheetDialog" parent="Theme.Material3.DayNight.BottomSheetDialog">
        <item name="android:windowIsFloating">false</item>
    </style>

    <!-- Buttons styles -->
    <style name="Widget.App.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/background_card</item>"
        <item name="backgroundTint">@color/background_card</item>
        <item name="tint">@color/secondary_main</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="cornerRadius">@dimen/radius_4dp</item>
        <item name="rippleColor">@color/accent_secondary</item>
        <!--<item name="strokeColor">@color/text_secondary</item>
        <item name="strokeWidth">@dimen/stroke_2dp</item>-->
    </style>
    <style name="Widget.App.Spinner" parent="Widget.AppCompat.Spinner">
        <item name="android:popupBackground">@drawable/bg_spinner_field</item>
    </style>

    <!-- Splash Screen Theme: fullscreen, no ActionBar, fondo idéntico al de la app -->
    <style name="Theme.NotificationCapture.Splash" parent="Theme.NotificationCapture">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@color/primary_main</item>
    </style>

    <!-- Tema para la Activity flotante del Widget -->
    <style name="Theme.NotificationCapture.Transparent" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_secondary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.5</item>
    </style>

</resources>
