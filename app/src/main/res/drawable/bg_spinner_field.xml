<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/background_card_90" />
            <corners android:radius="12dp" />
            <padding
                android:bottom="4dp"
                android:left="2dp"
                android:right="2dp"
                android:top="4dp" />
            <stroke
                android:width="2dp"
                android:color="@color/background_card_90" />
        </shape>
    </item>
</layer-list>
