<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Checked State: Red with rounded Right corners -->
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/red"/>
            <corners 
                android:topLeftRadius="0dp" 
                android:bottomLeftRadius="0dp"
                android:topRightRadius="@dimen/radius_8dp"
                android:bottomRightRadius="@dimen/radius_8dp"/>
        </shape>
    </item>
    
    <!-- Default State: Grey with rounded Right corners -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/grey_unselected"/>
            <corners 
                android:topLeftRadius="0dp" 
                android:bottomLeftRadius="0dp"
                android:topRightRadius="@dimen/radius_8dp"
                android:bottomRightRadius="@dimen/radius_8dp"/>
        </shape>
    </item>
</selector>

