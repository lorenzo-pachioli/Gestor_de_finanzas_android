<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Selected Tab (Chrome look: matches background, rounded top) -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/background_main" />
            <corners
                android:topLeftRadius="8dp"
                android:topRightRadius="8dp" />
        </shape>
    </item>
    <!-- Unselected Tab (Chrome look: darker/different background, slightly separated) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/background_card" />
            <corners
                android:topLeftRadius="8dp"
                android:topRightRadius="8dp" />
        </shape>
    </item>
</selector>
